  relicInfos:
  - relicName: The Promethean Hearth
    eraLabel: PALEOLITHIC // 1.500.000 B.C.
    description: Eternal ember forge. Controlling thermal energy doubled hominid brain caloric intake and birthed human hearth culture.
    glowColor: {r: 1, g: 0.55, b: 0.15, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Flint Knapping Anvil
    eraLabel: ACHEULEAN // 300.000 B.C.
    description: Percussion-flaked obsidian and flint biface hand-axes. The first intentional physical embodiment of mental foresight.
    glowColor: {r: 1, g: 0.7, b: 0.25, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Bronze Armillary Astrolabe
    eraLabel: ANTIQUITY & RENAISSANCE // 150 B.C.
    description: Interlocking brass rings modeling celestial mechanics. Turning observation into navigation and cartography.
    glowColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Gutenberg Movable Press
    eraLabel: PRINTING REVOLUTION // 1440 A.D.
    description: Cast lead types and screw press. Decoupling human memory from biological mortality and democratizing empirical wisdom.
    glowColor: {r: 0.95, g: 0.65, b: 0.3, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Quantum Silicon Monolith
    eraLabel: COMPUTATIONAL AGE // 1947 - 2026 A.D.
    description: Purified quartz crystal etched with billion-transistor circuits. Transforming fire and sand into machine cognition.
    glowColor: {r: 0.2, g: 0.85, b: 1, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Chrono-Return Monolith
    eraLabel: TERRAN EMBASSY ANCHOR
    description: Touch the golden brazier's microcosm sphere to reverse the sensory dive and return to the Museum Welcome Chamber.
    glowColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    proximitySound: {fileID: 8300000, guid: ebadb71ec3b89364199577396b957366, type: 3}
