  - {fileID: 1732620853}
  - {fileID: 1936955229}
  - {fileID: 2049890490}
  - {fileID: 1672441040}
  relicInfos:
  - relicName: Svalbard Global Seed Vault
    eraLabel: ARCTIC SANCTUARY // 2008 A.D.
    description: 120 meters deep inside Svalbard sandstone permafrost, humanity secured over 1.3 million distinct seed accessions. The ultimate planetary insurance for Earth's biosphere.
    glowColor: {r: 0.2, g: 0.95, b: 0.85, a: 1}
    proximitySound: {fileID: 8300000, guid: f9a879c27c464e6439a51ed5d6159d7a, type: 3}
  - relicName: The Rosetta Stone
    eraLabel: PTOLEMAIC DYNASTY // 196 B.C.
    description: A decree carved in Hieroglyphs, Demotic, and Greek. The linguistic catalyst that allowed modern humans to resurrect lost millennia of ancestral civilization.
    glowColor: {r: 1, g: 0.85, b: 0.45, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: The Library of Alexandria
    eraLabel: HELLENISTIC ARCHIVE // 300 B.C.
    description: 'The legendary scroll repository where humanity first attempted to gather all knowledge under one roof: geometry, astronomy, poetry, and medicine.'
    glowColor: {r: 1, g: 0.75, b: 0.35, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: The Human Genome DNA Spire
    eraLabel: MOLECULAR THRESHOLD // 2003 A.D.
    description: The 3.2 billion chemical base-pair code of Homo sapiens fully mapped. The moment life on Earth stopped being merely written by natural selection and learned to read itself.
    glowColor: {r: 0.25, g: 0.9, b: 1, a: 1}
    proximitySound: {fileID: 8300000, guid: f9a879c27c464e6439a51ed5d6159d7a, type: 3}
  - relicName: The Violoncello of Human Emotion
    eraLabel: SACRED ACOUSTICS // 1700 A.D.
    description: Carved from spruce and maple, vibrating at frequencies that bypass intellect to stir unconditional tears, serenity, and longing across all language barriers.
    glowColor: {r: 1, g: 0.82, b: 0.45, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Chronos Return Monolith
    eraLabel: WELCOME CHAMBER GATEWAY
    description: Reach out and touch the hovering miniature sphere to cradle the memory of humanity and return to Station III in the XENOASIS Welcome Chamber.
    glowColor: {r: 0.35, g: 0.95, b: 0.9, a: 1}
    proximitySound: {fileID: 8300000, guid: ebadb71ec3b89364199577396b957366, type: 3}
  interactionRadius: 2.2
  glowHighlightMaterial: {fileID: 0}
  returnMonolith: {fileID: 1672441040}
  returnSphere: {fileID: 1738362380}
  returnPortalParticles: {fileID: 340925795}
