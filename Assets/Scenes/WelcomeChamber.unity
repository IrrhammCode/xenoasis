--- !u!102 &1740536059
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1740536057}
  m_Text: 'In Memphis, Egypt, priests carved a royal decree across three scripts:

    Hieroglyphs for the gods, Demotic for the people, and Greek for the crown.

    Two millennia later, Terrans used this linguistic triad to unlock lost millennia of voices.'
  m_OffsetZ: 0
  m_CharacterSize: 0.0055
  m_LineSpacing: 1
  m_Anchor: 1
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 20
