  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumTerminalDisplay
  pages:
  - title: I. THE PRIMORDIAL CRADLE
    eraCode: ARCHEAN EON // 3.8 BILLION B.C.
    bodyText: 'Water arrived via cosmic cometary bombardment. In boiling hydrothermal tide pools, early RNA polymers catalyzed the memory of life.


      Touch the Sacred Basin to initiate the water bloom ritual.'
  - title: THE MEMORY OF WATER
    eraCode: ASTROBIOLOGY // PHYSIOLOGY
    bodyText: 'Every human tear, blood plasma, and cellular fluid maintains the identical electrolyte ratio of Earth''s ancient Archean sea.


      Humans never left the primordial ocean; they simply evolved membranes to carry the sea within.'
  - title: DIVE PROTOCOL // WORLD 1
    eraCode: SENSORY 6DoF IMMERSION READY
    bodyText: 'Full VR world transition available: The Primordial Cradle.


      Reach out and grasp the Living Terran Sphere, or press the DIVE PEDESTAL to pull the sphere into your consciousness and enter the Archean lagoon.'
  currentPageIndex: 0
  titleTextMesh: {fileID: 935004635}
  bodyTextMesh: {fileID: 1433912661}
  footerTextMesh: {fileID: 1847929548}
  terminalScreenLight: {fileID: 376564976}
