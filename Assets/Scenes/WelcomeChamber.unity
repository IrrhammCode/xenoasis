TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 233106699}
  m_Text: 'For four billion years, Earth life was bound to its planetary cradle.

    In July 1969, two Terrans stepped onto the regolith of the Moon.

    Left upon the ladder of the descent stage was a stainless steel plaque:

    "Here men from the planet Earth first set foot upon the Moon. We came in peace for all mankind."'
