  relicInfos:
  - relicName: Hydrothermal Smoker
    description: Deep mineral chimney venting hydrogen sulfide and methane. The thermal
      catalytic womb where primeval peptides folded.
    glowColor: {r: 1, g: 0.5, b: 0.1, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Stromatolite Dome
    description: Cyanobacteria reef matrix. The pioneering builders who spent 2 billion
      years generating Earth's breathable atmosphere.
    glowColor: {r: 0.2, g: 0.9, b: 0.7, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Ammonite Fossil Relic
    description: Spiral nautilus shell crystallizing the sacred Fibonacci spiral
      of marine life, embedded in Archean basalt.
    glowColor: {r: 0.3, g: 0.8, b: 1, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Prebiotic Crystal Core
    description: Levitating kyanite cluster sealing a primordial water droplet with
      Archean chirality memory.
    glowColor: {r: 0.1, g: 1, b: 0.9, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Bioluminescent Lotus
    description: Primeval aquatic flora glowing in the twilight tide pool, sensitive
      to human presence.
    glowColor: {r: 0, g: 0.95, b: 0.8, a: 1}
    proximitySound: {fileID: 8300000, guid: a08d9e5596f9b094eac748d7e64eb4db, type: 3}
  - relicName: Return Portal Monolith
    description: Terran Embassy anchor. Touch the miniature museum sphere to reverse
      the sensory dive and return to the archive.
    glowColor: {r: 1, g: 0.85, b: 0.3, a: 1}
    proximitySound: {fileID: 8300000, guid: ebadb71ec3b89364199577396b957366, type: 3}
  interactionRadius: 1.5
  glowHighlightMaterial: {fileID: 0}
  returnMonolith: {fileID: 1196081263}
  returnSphere: {fileID: 211917093}
  portalParticles: {fileID: 608652187}
  playerSpawnPoint: {fileID: 347811406}
  spawnFadeInDuration: 1.5
